{
  "expo": {
    "name": "Desenvolvimento_Mobile",
    "slug": "Desenvolvimento_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.Desenvolvimento_Mobile",
      "edgeToEdgeEnabled": true,
      "primaryColor": "#FF0054"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "styles": {
              "colorPrimary": "#FF0054",
              "colorPrimaryDark": "#CC0042",
              "colorAccent": "#FF0054"
            }
          }
        }
      ]
    ]
  }
}