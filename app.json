{
  "expo": {
    "name": "Ponto Gestor",
    "slug": "ponto-gestor",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#FF0054",
    "ios": {
      "supportsTablet": true,
      "icon": "./src/assets/images/icon.png"
    },
    "android": {
      "package": "com.anonymous.ponto_gestor",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#FF0054"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "styles": {
              "colorPrimary": "#FF0054",
              "colorPrimaryDark": "#CC0042",
              "colorAccent": "#FF0054"
            }
          }
        }
      ],
      "expo-audio"
    ],
    "owner": "lucasflores",
    "extra": {
      "eas": {
        "projectId": "3d694ba8-2b01-4631-8120-df246c16a851"
      }
    }
  }
}
